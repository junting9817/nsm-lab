{
  "uid": "nsm-live-traffic",
  "title": "NSM — Traffic Overview",
  "description": "What reaches the sensor and leaves it: connections, bytes, ports, services, alert volume and pipeline freshness.",
  "tags": [
    "nsm",
    "phase7",
    "traffic"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "self_ip",
        "label": "Sensor external IP to exclude",
        "description": "Removes test requests the sensor sent to its own external IP (hairpin) from inbound statistics",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "nsm-clickhouse"
        },
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "query": {
          "refId": "self_ip",
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT address FROM nsm.lab_addresses WHERE role = 'sensor'"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Zeek connections",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS connections FROM nsm.zeek_conn WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Connections that ended in the selected range (Zeek conn.log)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inbound source IPs",
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExact(id_orig_h) AS sources FROM nsm.zeek_conn WHERE $__timeFilter(ts) AND NOT local_orig AND local_resp AND id_orig_h != '${self_ip}'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Distinct sources of connections into the sensor, excluding its own external IP (self-test hairpin)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Suricata alerts",
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS alerts FROM nsm.suricata_alert WHERE $__timeFilter(timestamp) AND in_iface = 'ens4'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Signature alerts on ens4 (the validation harness replays on nsm-replay0 and is excluded)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Kernel drop rate",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(stats_capture_kernel_drops, timestamp) / greatest(argMax(stats_capture_kernel_packets, timestamp), 1) AS drop_rate FROM nsm.suricata_stats WHERE $__timeFilter(timestamp)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "description": "Suricata AF_PACKET kernel drops / packets since engine start (latest value in range)",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Ingestion lag",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT dateDiff('second', max(ts), now64()) AS lag FROM nsm.zeek_conn"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Now minus the newest loaded Zeek connection. Connections are logged when they end, so long ones can raise it",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections by direction",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, multiIf(local_orig AND local_resp, 'internal', local_orig, 'outbound', 'inbound') AS direction, count() AS connections FROM nsm.zeek_conn WHERE $__timeFilter(ts) GROUP BY time, direction ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "inbound = internet → sensor, outbound = sensor → internet (Zeek Site::local_nets)",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bytes by direction (IP bytes)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, multiIf(local_orig AND local_resp, 'internal', local_orig, 'outbound', 'inbound') AS direction, sum(orig_ip_bytes + resp_ip_bytes) AS bytes FROM nsm.zeek_conn WHERE $__timeFilter(ts) GROUP BY time, direction ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes"
        },
        "overrides": []
      },
      "description": "IP bytes in both directions of each connection",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top inbound destination ports",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT id_resp_p AS port, proto AS protocol, anyIf(service, service != '') AS detected_service, count() AS connections, uniqExact(id_orig_h) AS sources FROM nsm.zeek_conn WHERE $__timeFilter(ts) AND NOT local_orig AND local_resp AND id_orig_h != '${self_ip}' GROUP BY port, protocol ORDER BY connections DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Only ports the VPC firewall allows reach the VM (22 and 80); everything else is dropped before capture",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top inbound source IPs",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT id_orig_h AS source, count() AS connections, uniqExact(id_resp_p) AS ports, arrayStringConcat(arrayMap(p -> toString(p), arraySort(groupUniqArray(5)(id_resp_p))), ',') AS sample_ports FROM nsm.zeek_conn WHERE $__timeFilter(ts) AND NOT local_orig AND local_resp AND id_orig_h != '${self_ip}' GROUP BY source ORDER BY connections DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Top sources by connection count",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Services seen",
      "gridPos": {
        "x": 18,
        "y": 12,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT if(service = '', '(not identified)', service) AS detected, count() AS connections FROM nsm.zeek_conn WHERE $__timeFilter(ts) GROUP BY detected ORDER BY connections DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Zeek's payload-based protocol identification",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Alerts by severity",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time, concat('severity ', toString(alert_severity)) AS level, count() AS alerts FROM nsm.suricata_alert WHERE $__timeFilter(timestamp) AND in_iface = 'ens4' GROUP BY time, level ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "description": "Details on the Alerts dashboard",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Data freshness",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT source, latest, dateDiff('second', latest, now64(3)) AS lag_s FROM ( SELECT 'zeek_conn' AS source, max(ts) AS latest FROM nsm.zeek_conn UNION ALL SELECT 'suricata_alert', max(timestamp) FROM nsm.suricata_alert WHERE in_iface = 'ens4' UNION ALL SELECT 'suricata_stats', max(timestamp) FROM nsm.suricata_stats UNION ALL SELECT 'cowrie_events (honeypot)', max(timestamp) FROM nsm.cowrie_events UNION ALL SELECT 'detection_runs', max(run_at) FROM nsm.detection_runs WHERE NOT backfill UNION ALL SELECT 'vector_internal_metrics', max(timestamp) FROM nsm.vector_internal_metrics ) ORDER BY lag_s DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Newest row per source. Honeypot events arrive in batches (~1–2 min); detection runs are hourly; Suricata stats every minute",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Top DNS queries",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT query AS name, count() AS queries, uniqExact(id_orig_h) AS clients FROM nsm.zeek_dns WHERE $__timeFilter(ts) GROUP BY name ORDER BY queries DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Details on the DNS dashboard",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Top TLS server names",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nsm-clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nsm-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT server_name AS sni, count() AS sessions, uniqExact(id_resp_h) AS servers FROM nsm.zeek_ssl WHERE $__timeFilter(ts) AND server_name != '' GROUP BY sni ORDER BY sessions DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Details on the C2 Hunt dashboard",
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
