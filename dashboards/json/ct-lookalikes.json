  {
   "type": "table",
   "title": "Certificates behind the top findings",
   "description": "A short, recent certificate history is the interesting shape. Years of renewals is somebody's business.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "nsm-clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "nsm-clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT e.candidate AS name, count() AS certificates, min(e.not_before) AS first_seen, max(e.not_before) AS last_seen, any(e.issuer_name) AS issuer FROM ct.certificates AS e INNER JOIN (SELECT domain FROM ct.findings WHERE tier IN ('review','watch','weak')) AS f ON f.domain = e.candidate GROUP BY name ORDER BY certificates ASC"
    }
   ],
