     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT score, tier, domain, display, brand, klass AS class, arrayStringConcat(reasons, ' \u00b7 ') AS why FROM ct.findings ORDER BY score DESC, domain ASC"
