     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    }
   }
  },
  {
   "type": "table",
   "title": "Answers over time",
   "description": "crt.sh fails on roughly a quarter of requests; errors leave a name overdue rather than marking it checked.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "nsm-clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 17,
