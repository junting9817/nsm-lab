  {
   "type": "barchart",
   "title": "Coverage by class \u2014 where the blind spots are",
   "description": "Homoglyph is the class a reader cannot catch, so an unasked homoglyph candidate is the most expensive kind of gap.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "nsm-clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "nsm-clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT c.klass AS class, uniqExactIf(k.domain, k.status != 'error') AS asked, count() - uniqExactIf(k.domain, k.status != 'error') AS unasked FROM ct.candidates AS c LEFT JOIN ct.checks AS k ON k.domain = c.domain GROUP BY class ORDER BY count() DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 80,
      "gradientMode": "none",
      "axisPlacement": "auto"
     }
