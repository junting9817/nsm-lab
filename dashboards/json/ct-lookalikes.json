      "uid": "nsm-clickhouse"
     },
     "editorType": "sql",
     "format": 1,
     "queryType": "table",
     "rawSql": "SELECT toDate(checked_at) AS day, countIf(status = 'found') AS found, countIf(status = 'absent') AS absent, countIf(status = 'error') AS errors FROM ct.checks GROUP BY day ORDER BY day DESC"
