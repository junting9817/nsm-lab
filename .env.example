# Keys for .env. setup-stack.sh adds any key missing from .env and replaces CHANGE_ME with a random secret.
# Never commit .env (.gitignore).

# Grafana administrator. The default name admin is the first guess in brute-force attempts, so it is not used.
GRAFANA_ADMIN_USER=nsm-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ClickHouse account passwords (privileges: ingest/clickhouse/users.d/nsm-users.xml)
CH_VECTOR_PASSWORD=CHANGE_ME
CH_GRAFANA_PASSWORD=CHANGE_ME
CH_RESPONDER_PASSWORD=CHANGE_ME

# Bearer token Grafana's alert webhook sends to the responder (dashboards/provisioning/alerting)
RESPONDER_WEBHOOK_TOKEN=CHANGE_ME

# Responder mode: dry-run (default) or enforce — enforce only after Phase 6 approval (docs/architecture.md section 13)
RESPONDER_MODE=dry-run

# Address prefixes that must not appear in published screenshots (docs/screenshots/capture.sh), comma-separated, e.g. 203.0.113.
NSM_SCREENSHOT_DENY=

# Addresses this lab owns, excluded from "who attacked us" statistics. Format: address=role:note, comma separated.
# Roles are sensor | honeypot | other. Loaded by infra/scripts/setup-lab-addresses.sh.
LAB_ADDRESSES="<sensor external ip>=sensor:external address of the NSM sensor,<honeypot external ip>=honeypot:the Cowrie VM"
